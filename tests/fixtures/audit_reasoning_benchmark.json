        {
          "name": "Distinguishes distinct apps from duplicate reporters",
          "indicators": [
            "same app",
            "one app",
            "deduplicat",
            "two member",
            "shared app",
            "app 4061"
          ]
        },
        {
          "name": "Qualifies pctTotal denominator",
          "indicators": [
            "denominator",
            "not cpu",
            "not a cpu",
            "cannot infer cpu",
            "percentage semantics"
          ]
        },
        {
          "name": "Treats offline status separately",
          "indicators": [
            "offline",
            "mesh"
          ]
        },
        {
          "name": "Suggests discriminating observation",
          "indicators": [
            "read-only",
            "execution cadence",
            "execution frequency",
            "compare logs",
            "inspect schedule",
            "check logs"
          ]
        }
      ],
      "potential_overclaims": [
        "109% cpu utilisation",
        "109% cpu utilization",
        "confirmed hub cpu saturation",
        "disable all",
        "root cause proven"
      ]
    },
